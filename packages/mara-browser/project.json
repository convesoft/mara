{
  "name": "mara-browser",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "targets": {
    "build": {
      "command": "node packages/mara-browser/copy-module.mjs",
      "cache": true,
      "dependsOn": [{ "projects": ["mara-wasm"], "target": "build" }],
      "inputs": [
        "{projectRoot}/copy-module.mjs",
        { "dependentTasksOutputFiles": "**/*.wasm" },
        "{workspaceRoot}/.cargo/config.toml",
        "{workspaceRoot}/.cargo/config",
        "{workspaceRoot}/rust-toolchain.toml",
        { "env": "CARGO_TARGET_DIR" },
        { "env": "CARGO_BUILD_TARGET_DIR" }
      ],
      "outputs": ["{projectRoot}/mara.wasm"]
    }
  }
}
